include_guard(GLOBAL)
set(_GD_KIT_ARCHIVE "${CMAKE_CURRENT_LIST_DIR}/GDKit-0.1.0.tar.gz")
file(SHA256 "${_GD_KIT_ARCHIVE}" _GD_KIT_ACTUAL)
if(NOT _GD_KIT_ACTUAL STREQUAL "d841969e71824ea0ff8db07b54bde14bf035667ee338c2fb6eb1b8a3d70f695d")
    message(FATAL_ERROR "GD Kit archive differs from the pinned 0.1.0 dependency")
