file(ARCHIVE_EXTRACT INPUT "${_GD_KIT_ARCHIVE}" DESTINATION "${_GD_KIT_SOURCE}")
if(NOT TARGET gdkit::ui)
    add_subdirectory("${_GD_KIT_SOURCE}/gdkit" "${_GD_KIT_SOURCE}/build" EXCLUDE_FROM_ALL)
    set_property(GLOBAL PROPERTY GD_KIT_PIN "d841969e71824ea0ff8db07b54bde14bf035667ee338c2fb6eb1b8a3d70f695d")
else()
    get_property(_GD_KIT_PREVIOUS GLOBAL PROPERTY GD_KIT_PIN)
